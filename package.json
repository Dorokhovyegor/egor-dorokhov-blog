{
  "name": "egor-dorokhov-blog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:db": "docker compose up -d postgres",
    "dev:server": "DB_DSN=postgres://blog:blog@127.0.0.1:55432/blog?sslmode=disable go run ./cmd/blog",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "post:new": "node scripts/new-post.mjs",
    "content:check": "node scripts/check-content.mjs",
    "backend:check": "go test ./... && go build -o /tmp/egor-blog-check ./cmd/blog",
    "check": "npm run content:check && npm run build && npm run backend:check",
    "server": "go run ./cmd/blog",
    "start": "go run ./cmd/blog"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.1"
  }
}
